  "shared-fetch-panic": {
    "probe": {
      "mode": "task-boundary-before-io-v1",
      "serviceIds": [
        "test-provider"
      ],
      "token": "gate-parallel",
      "callerCount": 3,
      "callerBudgetMs": 1000,
      "barrierWaitMaxMs": 1000,
      "sequence": [
        "attempt-recorded-active-published",
        "two-joiners-attached",
        "release-panic",
        "all-waiters-settled",
        "cooldown-elapsed",
        "release-recovery"
      ]
    },
    "expect": {
      "outcome": "jwksGatePanicRecovery",
      "prerequisiteReady": true,
      "backendCalls": [],
      "jwksFetches": 1,
      "jwksCalls": [
        {
          "target": "jwks",
          "method": "GET",
          "uri": "/jwks"
        }
      ],
      "failure": {
        "taskStarts": 1,
        "joinersAttached": 2,
        "networkRequests": 0,
        "waitersTerminated": 3,
        "verifiedPrincipals": 0,
        "attemptRecordedBeforeTask": true,
        "activePublishedBeforePanic": true,
        "activeAfterCleanup": false,
        "cooldownRetained": true,
        "callerBudgetMs": 1000,
        "publicErrorMapping": "unspecified-by-approved-contract"
      },
      "recovery": {
        "afterCooldown": true,
        "taskStarts": 1,
        "joinersAttached": 0,
        "networkRequests": 1,
        "verifiedPrincipals": 1,
        "cachePublished": true,
        "activeAfterCompletion": false
      }
    }
  }
