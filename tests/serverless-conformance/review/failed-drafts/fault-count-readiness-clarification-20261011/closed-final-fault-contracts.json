{
  "runtime-api-unset-v1": {
    "probe": {
      "fault": "runtime-api-unset-v1",
      "reportingTimeoutMs": 2000,
      "schedulingToleranceMs": 1000,
      "trigger": "missing-stage-v1"
    },
    "expect": {
      "outcome": "initReportTransportFailure",
      "code": "InvalidConfiguration",
      "backendCalls": [],
      "jwksFetches": 0,
      "reporting": {
        "attempts": 0,
        "receivedPosts": 0,
        "retries": 0,
        "invocationPolls": 0,
        "endpoint": "/2018-06-01/runtime/init/error",
        "header": {
          "Lambda-Runtime-Function-Error-Type": "Runtime.InitError"
        },
        "body": {
          "errorType": "InvalidConfiguration",
          "errorMessage": "configuration: missing light-lambda.stage"
        },
        "maxBodyBytes": 1024
      },
      "processExit": {
        "code": 1,
        "maxAfterInitFailureMs": 3000
      },
      "diagnosticContract": {
        "requiredMessage": "configuration: missing light-lambda.stage",
        "requiredLevel": "error",
        "transportDiagnostic": "runtime-api-unset-v1",
        "forbiddenValues": [
          "test-only-secret-sentinel",
          "test-only-password-sentinel"
        ],
        "forbidConfigurationValues": true
      }
    }
  },
