{
  "schema": "light-lambda-conformance/fixture/v1",
  "id": "A-01-mask-error-parameters-sink-init-v1",
  "title": "Error-only audit masks fields without altering backend inputs",
  "ledger": [
    "A-01",
    "A-02",
    "C-10"
  ],
  "config": {
    "values": {
      "light-lambda.stage": "test-only"
    },
    "files": {
      "audit": {
        "enabled": true,
        "statusCode": true,
        "responseTime": false,
        "auditOnError": true,
        "auditStackTrace": false,
        "mask": true,
        "requestBodyMaxSize": 1000,
        "audit": [
          "requestBody",
          "queryParameters",
          "pathParameters"
        ],
        "headers": [
          "x-test-mask"
        ],
        "timestampFormat": "'synthetic-time'"
      },
      "values": {},
      "lambda-app": {
        "lambdaAppId": "test-only-gateway",
        "encodeBase64Request": false,
        "encodeBase64Response": false
      },
      "lambda-proxy": {
        "enabled": true,
        "region": "us-east-1",
        "metricsInjection": false,
        "logType": "Tail",
        "functions": {
          "/x@get": "FnX",
          "/x@post": "FnX"
        }
      },
      "handler": {
        "enabled": true,
        "handlers": [
          "com.networknt.aws.lambda.handler.middleware.proxy.LambdaProxyMiddleware@proxy",
          "com.networknt.aws.lambda.characterization.AuditMaskErrorTest$Parameters@parameters",
          "com.networknt.aws.lambda.handler.middleware.audit.AuditMiddleware@audit"
        ],
        "chains": {
          "request": [
            "parameters",
            "audit"
          ],
          "response": []
        },
        "defaultHandlers": [
          "request",
          "proxy",
          "response"
        ],
        "paths": []
      },
      "mask": {
        "regex": {
          "requestHeader": {
            "x-test-mask": "(.*)"
          },
          "queryParameters": {
            "q": "(.*)"
          },
          "pathParameters": {
            "id": "(.*)"
          }
        },
        "json": {
          "requestBody": {
            "$.password": "(.*)"
          }
        }
      }
    }
  },
  "clock": {
    "mode": "relative-wall",
    "description": "Explicit synthetic literal audit.timestampFormat avoids variable log metadata; actual record and message are preserved. No virtual clock."
  },
  "keys": {},
  "tokens": {},
  "substitutions": [],
  "nondeterministic": [],
