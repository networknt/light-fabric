{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightapi.net/schemas/workflow-admin/0.2.0-restoration",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "PageInput": {
      "type": "object",
      "description": "Offset pagination. cursor is the decimal row offset returned as nextCursor; it is not a stable keyset cursor under concurrent writes.",
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+$"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "additionalProperties": false
    },
    "PageMeta": {
      "type": "object",
      "required": [
        "pageSize",
        "hasMore"
      ],
      "properties": {
        "pageSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasMore": {
          "type": "boolean"
        },
        "authorizedTotal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ActionHint": {
      "type": "object",
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ProcessSummary": {
      "type": "object",
      "required": [
        "processId",
        "definitionId",
        "workflowName",
        "workflowVersion",
        "processState",
        "createdAt",
        "updatedAt",
        "canCancelInvocation"
      ],
      "properties": {
        "processId": {
          "$ref": "#/$defs/Uuid"
        },
        "workflowInstanceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "featureRunId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "definitionId": {
          "$ref": "#/$defs/Uuid"
        },
        "workflowName": {
          "type": "string"
        },
        "workflowVersion": {
          "type": "string"
        },
        "processState": {
          "type": "string"
        },
        "invocationState": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocationStateVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerDisplay": {
          "type": [
            "string",
            "null"
          ]
        },
        "safeFailureSummary": {
          "type": [
            "string",
            "null"
          ]
        },
        "featureState": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmState": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmGeneration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "canCancelInvocation": {
          "$ref": "#/$defs/ActionHint"
        },
        "canCancelFeature": {
          "$ref": "#/$defs/ActionHint"
        }
      },
      "additionalProperties": false
    },
    "HumanTaskSummary": {
      "type": "object",
      "required": [
        "taskAsstId",
        "taskId",
        "processId",
        "assignmentVersion",
        "assignmentType",
        "assignmentId",
        "assignmentStatus",
        "taskStatus",
        "assignedAt",
        "canClaim",
        "canRelease",
        "canComplete",
        "readOnly"
      ],
      "properties": {
        "taskAsstId": {
          "$ref": "#/$defs/Uuid"
        },
        "taskId": {
          "$ref": "#/$defs/Uuid"
        },
        "processId": {
          "$ref": "#/$defs/Uuid"
        },
        "workflowInstanceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignmentVersion": {
          "type": "integer",
          "minimum": 0
        },
        "assignmentType": {
          "enum": [
            "USER",
            "ROLE"
          ]
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1
        },
        "assignmentLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignmentStatus": {
          "enum": [
            "ASSIGNED",
            "CLAIMED",
            "COMPLETED",
            "CANCELLED"
          ]
        },
        "taskStatus": {
          "type": "string"
        },
        "assignedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "claimedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimExpiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "canClaim": {
          "$ref": "#/$defs/ActionHint"
        },
        "canRelease": {
          "$ref": "#/$defs/ActionHint"
        },
        "canComplete": {
          "$ref": "#/$defs/ActionHint"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Ask": {
      "type": "object",
      "required": [
        "mode",
        "prompt",
        "required"
      ],
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "approval",
            "confirm",
            "choice",
            "multiChoice",
            "text",
            "object"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "allowComment": {
          "type": "boolean"
        },
        "commentRequired": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": true
        },
        "form": {
          "type": "array"
        },
        "default": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "MutationResult": {
      "type": "object",
      "required": [
        "operationId",
        "accepted",
        "state"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/$defs/Uuid"
        },
        "accepted": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "StartKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "StartInput": {
      "type": "object",
      "required": [
        "workflowDefinitionId",
        "input",
        "idempotencyKey"
      ],
      "properties": {
        "workflowDefinitionId": {
          "$ref": "#/$defs/Uuid"
        },
        "input": {
          "type": "object",
          "maxProperties": 256
        },
        "idempotencyKey": {
          "$ref": "#/$defs/StartKey"
        }
      },
      "additionalProperties": false
    },
    "StartReceipt": {
      "type": "object",
      "required": [
        "accepted",
        "workflowInstanceId",
        "processId",
        "workflowDefinitionId",
        "definitionDigest",
        "state",
        "invocationStateVersion",
        "acceptedAt",
        "replayed"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "workflowInstanceId": {
          "$ref": "#/$defs/Uuid"
        },
        "processId": {
          "$ref": "#/$defs/Uuid"
        },
        "workflowDefinitionId": {
          "$ref": "#/$defs/Uuid"
        },
        "definitionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "state": {
          "enum": [
            "ACCEPTED",
            "RUNNING",
            "WAITING"
          ]
        },
        "invocationStateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "DecisionInput": {
      "type": "object",
      "required": ["taskAsstId", "assignmentVersion", "requestId", "requestDigest", "decision", "idempotencyKey"],
      "properties": {
        "taskAsstId": {"$ref": "#/$defs/Uuid"},
        "assignmentVersion": {"type": "integer", "minimum": 1},
        "requestId": {"$ref": "#/$defs/Uuid"},
        "requestDigest": {"$ref": "#/$defs/Digest"},
        "decision": {"enum": ["APPROVE", "REJECT"]},
        "comment": {"type": "string", "maxLength": 2000},
        "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "DecisionReceipt": {
      "type": "object",
      "required": ["decisionId", "requestId", "taskAsstId", "state", "assignmentVersion", "portalCommittedAt"],
      "properties": {
        "decisionId": {"$ref": "#/$defs/Uuid"},
        "requestId": {"$ref": "#/$defs/Uuid"},
        "taskAsstId": {"$ref": "#/$defs/Uuid"},
        "state": {"enum": ["PENDING_DELIVERY", "GRANTED", "REJECTED", "STALE"]},
        "assignmentVersion": {"type": "integer", "minimum": 1},
        "portalCommittedAt": {"anyOf": [{"$ref": "#/$defs/Timestamp"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "NativeDeleteInput":{"type":"object","required":["processId","expectedLifecycleVersion","reason","idempotencyKey"],"properties":{"processId":{"$ref":"#/$defs/Uuid"},"expectedLifecycleVersion":{"type":"integer","minimum":1},"reason":{"type":"string","minLength":1,"maxLength":1000},"idempotencyKey":{"type":"string","minLength":8,"maxLength":128}},"additionalProperties":false},
    "NativeDeleteReceipt":{"type":"object","required":["operationId","processId","lifecycleVersion","logicalDeletion","artifactCleanup","artifacts"],"properties":{"operationId":{"$ref":"#/$defs/Uuid"},"processId":{"$ref":"#/$defs/Uuid"},"lifecycleVersion":{"type":"integer","minimum":2},"logicalDeletion":{"const":"RECORDED"},"artifactCleanup":{"enum":["PENDING","RETAINED","COMPLETE"]},"artifacts":{"type":"object","required":["pending","failed","deleted","legalHold","retained"],"properties":{"pending":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"deleted":{"type":"integer","minimum":0},"legalHold":{"type":"integer","minimum":0},"retained":{"type":"integer","minimum":0}},"additionalProperties":false}},"additionalProperties":false},
    "NativeTaskGetInput":{"type":"object","required":["taskId"],"properties":{"taskId":{"$ref":"#/$defs/Uuid"}},"additionalProperties":false},
    "NativeTaskDetail":{"type":"object","required":["taskId","processId","workflowInstanceId","workflowTaskId","type","state","taskVersion","startedAt","completedAt","deadline","resultCode","effectState","assignments"],"properties":{"taskId":{"$ref":"#/$defs/Uuid"},"processId":{"$ref":"#/$defs/Uuid"},"workflowInstanceId":{"$ref":"#/$defs/Uuid"},"workflowTaskId":{"type":"string"},"type":{"type":"string"},"state":{"enum":["RUNNING","WAITING","COMPLETED","FAILED"]},"taskVersion":{"type":"integer","minimum":1},"startedAt":{"$ref":"#/$defs/Timestamp"},"completedAt":{"anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"deadline":{"anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"resultCode":{"type":["string","null"]},"effectState":{"type":"string"},"assignments":{"type":"array","items":{"type":"object","required":["taskAsstId","state","type","assigneeId"],"properties":{"taskAsstId":{"$ref":"#/$defs/Uuid"},"state":{"type":"string"},"type":{"type":"string"},"assigneeId":{"type":"string"}},"additionalProperties":false}}},"additionalProperties":false},
    "NativeNoteInput":{"type":"object","required":["processId","text","idempotencyKey"],"properties":{"processId":{"$ref":"#/$defs/Uuid"},"taskId":{"$ref":"#/$defs/Uuid"},"text":{"type":"string","minLength":1,"maxLength":4000},"idempotencyKey":{"type":"string","minLength":8,"maxLength":128}},"additionalProperties":false},
    "NativeNote":{"type":"object","required":["noteId","processId","workflowInstanceId","taskId","text","actor","createdAt"],"properties":{"noteId":{"$ref":"#/$defs/Uuid"},"processId":{"$ref":"#/$defs/Uuid"},"workflowInstanceId":{"$ref":"#/$defs/Uuid"},"taskId":{"anyOf":[{"$ref":"#/$defs/Uuid"},{"type":"null"}]},"text":{"type":"string"},"actor":{"type":"string"},"createdAt":{"$ref":"#/$defs/Timestamp"}},"additionalProperties":false},
    "NativeNotesQuery":{"type":"object","required":["processId"],"properties":{"processId":{"$ref":"#/$defs/Uuid"},"page":{"$ref":"#/$defs/PageInput"}},"additionalProperties":false},
    "NativeNotesPage":{"type":"object","required":["notes","page"],"properties":{"notes":{"type":"array","items":{"$ref":"#/$defs/NativeNote"}},"page":{"$ref":"#/$defs/PageMeta"}},"additionalProperties":false}
  }
}
