{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lightapi.net/schemas/workflow-admin/0.2.0-restoration",
  "$defs":{
    "Uuid":{"type":"string","format":"uuid"},
    "Timestamp":{"type":"string","format":"date-time"},
    "PageInput":{"type":"object","description":"Offset pagination. cursor is the decimal row offset returned as nextCursor; it is not a stable keyset cursor under concurrent writes.","properties":{"cursor":{"type":"string","minLength":1,"pattern":"^[0-9]+$"},"pageSize":{"type":"integer","minimum":1,"maximum":100,"default":25}},"additionalProperties":false},
    "PageMeta":{"type":"object","required":["pageSize","hasMore"],"properties":{"pageSize":{"type":"integer","minimum":0,"maximum":100},"nextCursor":{"type":["string","null"]},"hasMore":{"type":"boolean"},"authorizedTotal":{"type":"integer","minimum":0}},"additionalProperties":false},
    "ActionHint":{"type":"object","required":["allowed"],"properties":{"allowed":{"type":"boolean"},"reason":{"type":["string","null"]}},"additionalProperties":false},
    "ProcessSummary":{"type":"object","required":["processId","definitionId","workflowName","workflowVersion","processState","createdAt","updatedAt","canCancelInvocation"],"properties":{"processId":{"$ref":"#/$defs/Uuid"},"workflowInstanceId":{"anyOf":[{"$ref":"#/$defs/Uuid"},{"type":"null"}]},"featureRunId":{"anyOf":[{"$ref":"#/$defs/Uuid"},{"type":"null"}]},"definitionId":{"$ref":"#/$defs/Uuid"},"workflowName":{"type":"string"},"workflowVersion":{"type":"string"},"processState":{"type":"string"},"invocationState":{"type":["string","null"]},"invocationStateVersion":{"type":["integer","null"],"minimum":0},"createdAt":{"$ref":"#/$defs/Timestamp"},"updatedAt":{"$ref":"#/$defs/Timestamp"},"deadline":{"anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"ownerDisplay":{"type":["string","null"]},"safeFailureSummary":{"type":["string","null"]},"featureState":{"type":["string","null"]},"vmState":{"type":["string","null"]},"vmGeneration":{"type":["integer","null"],"minimum":0},"canCancelInvocation":{"$ref":"#/$defs/ActionHint"},"canCancelFeature":{"$ref":"#/$defs/ActionHint"}},"additionalProperties":false},
    "HumanTaskSummary":{"type":"object","required":["taskAsstId","taskId","processId","assignmentVersion","assignmentType","assignmentId","assignmentStatus","taskStatus","assignedAt","canClaim","canRelease","canComplete","readOnly"],"properties":{"taskAsstId":{"$ref":"#/$defs/Uuid"},"taskId":{"$ref":"#/$defs/Uuid"},"processId":{"$ref":"#/$defs/Uuid"},"workflowInstanceId":{"anyOf":[{"$ref":"#/$defs/Uuid"},{"type":"null"}]},"assignmentVersion":{"type":"integer","minimum":0},"assignmentType":{"enum":["USER","ROLE"]},"assignmentId":{"type":"string","minLength":1},"assignmentLabel":{"type":["string","null"]},"assignmentStatus":{"enum":["ASSIGNED","CLAIMED","COMPLETED","CANCELLED"]},"taskStatus":{"type":"string"},"assignedAt":{"$ref":"#/$defs/Timestamp"},"claimedBy":{"type":["string","null"]},"claimExpiresAt":{"anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"deadline":{"anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"category":{"type":["string","null"]},"reason":{"type":["string","null"]},"prompt":{"type":["string","null"]},"canClaim":{"$ref":"#/$defs/ActionHint"},"canRelease":{"$ref":"#/$defs/ActionHint"},"canComplete":{"$ref":"#/$defs/ActionHint"},"readOnly":{"type":"boolean"}},"additionalProperties":false},
    "Ask":{"type":"object","required":["mode","prompt","required"],"properties":{"action":{"type":["string","null"]},"mode":{"enum":["approval","confirm","choice","multiChoice","text","object"]},"prompt":{"type":"string","minLength":1},"required":{"type":"boolean"},"allowComment":{"type":"boolean"},"commentRequired":{"type":"boolean"},"options":{"type":"array","items":{"type":"object","required":["value"],"properties":{"value":{"type":"string"},"label":{"type":"string"},"description":{"type":"string"}},"additionalProperties":false}},"schema":{"type":"object","additionalProperties":true},"form":{"type":"array"},"default":{"type":"object","additionalProperties":true}},"additionalProperties":false},
    "MutationResult":{"type":"object","required":["operationId","accepted","state"],"properties":{"operationId":{"$ref":"#/$defs/Uuid"},"accepted":{"type":"boolean"},"state":{"type":"string"},"message":{"type":["string","null"]}},"additionalProperties":false}
  }
}
