{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remediation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "turnId": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "findingId": {
      "type": "string",
      "minLength": 1
    },
    "changedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ]
    },
    "dispute": {
      "type": "boolean"
    }
  },
  "required": [
    "turnId",
    "candidate",
    "findingId",
    "changedPaths",
    "evidence",
    "dispute"
  ]
}
