{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightapi.net/contracts/workflow-invocation/v1/mcp-result.schema.json",
  "title": "Workflow-backed MCP tool result",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "structuredContent", "isError"],
  "properties": {
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text"],
        "properties": {
          "type": { "const": "text" },
          "text": { "type": "string" }
        }
      }
    },
    "structuredContent": { "type": "object" },
    "isError": { "type": "boolean" }
  }
}
