{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightapi.net/contracts/a2a-backend/v1/business-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "contextId", "idempotencyKey", "skillId", "message", "metadata"],
  "properties": {
    "taskId": {"type": "string", "format": "uuid"},
    "contextId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 512},
    "skillId": {"type": ["string", "null"], "maxLength": 256},
    "message": {},
    "metadata": {}
  }
}
