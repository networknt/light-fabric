{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightapi.net/contracts/llm/projection-acknowledgement-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gatewayPublicationId", "hostId", "environment", "inventoryId", "inventoryGeneration", "inventoryDigest", "gatewayInstance", "sequence", "rootDigest", "appliedSchemaVersion", "readerVersion", "gatewayVersion", "materialGeneration", "resolvedTrustDigest", "evidenceKeySetVersion", "evidenceKeySetDigest", "state", "appliedAt", "acknowledgementDigest"],
  "properties": {
    "schemaVersion": {"const": "2"},
    "gatewayPublicationId": {"type": "string", "format": "uuid"},
    "hostId": {"type": "string", "format": "uuid"},
    "environment": {"type": "string", "minLength": 1},
    "inventoryId": {"type": "string", "format": "uuid"},
    "inventoryGeneration": {"type": "integer", "minimum": 1},
    "inventoryDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gatewayInstance": {"type": "string", "minLength": 1, "not": {"const": "gateway-local"}},
    "sequence": {"type": "integer", "minimum": 1},
    "rootDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "appliedSchemaVersion": {"const": "3"},
    "readerVersion": {"const": "3"},
    "gatewayVersion": {"type": "string", "minLength": 1},
    "materialGeneration": {"type": "integer", "minimum": 0},
    "resolvedTrustDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceKeySetVersion": {"type": "string", "minLength": 1},
    "evidenceKeySetDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["applied", "failed"]},
    "failureCategory": {"type": "string", "minLength": 1, "maxLength": 64},
    "failureCode": {"type": "string", "minLength": 1, "maxLength": 64},
    "appliedAt": {"type": "string", "format": "date-time"},
    "acknowledgementDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
