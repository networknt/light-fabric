{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightapi.net/contracts/llm/replica-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostId", "environment", "replicaInventoryId", "inventoryGeneration", "inventoryDigest", "desiredCount", "workloadKind", "workloadName", "workloadUid", "workloadResourceVersion", "validFrom", "validUntil", "members"],
  "properties": {
    "hostId": {"type": "string", "format": "uuid"},
    "environment": {"type": "string", "minLength": 1},
    "replicaInventoryId": {"type": "string", "format": "uuid"},
    "inventoryGeneration": {"type": "integer", "minimum": 1},
    "inventoryDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desiredCount": {"type": "integer", "minimum": 1},
    "workloadKind": {"type": "string", "minLength": 1},
    "workloadName": {"type": "string", "minLength": 1},
    "workloadUid": {"type": "string", "minLength": 1},
    "workloadResourceVersion": {"type": "string", "minLength": 1},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gatewayInstance", "podUid", "namespace", "serviceAccount", "required"],
        "properties": {
          "gatewayInstance": {"type": "string", "minLength": 1, "not": {"const": "gateway-local"}},
          "podUid": {"type": "string", "minLength": 1},
          "namespace": {"type": "string", "minLength": 1},
          "serviceAccount": {"type": "string", "minLength": 1},
          "required": {"const": true}
        }
      }
    }
  }
}

