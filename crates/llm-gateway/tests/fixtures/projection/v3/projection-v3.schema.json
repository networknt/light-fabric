{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightapi.net/contracts/llm/projection-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicationId", "hostId", "environment", "sequence", "rootDigest", "minimumGatewayVersion", "resources"],
  "properties": {
    "schemaVersion": {"const": "3"},
    "publicationId": {"type": "string", "format": "uuid"},
    "hostId": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "rootDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "minimumGatewayVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "enabledRoutingFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "ordered-routing"}
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceType", "resourceId", "resourceVersion", "digest"],
        "properties": {
          "resourceType": {"enum": ["llm-network-zone", "llm-provider-endpoint", "llm-deployment", "llm-pricing", "llm-route", "llm-policy"]},
          "resourceId": {"type": "string", "minLength": 1},
          "resourceVersion": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tombstone": {"type": "boolean", "default": false}
        }
      }
    }
  }
}
