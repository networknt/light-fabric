{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightapi.net/contracts/llm/cutover-artifact-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidatePublicationId", "inventoryDigest", "reports", "rollback"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "candidatePublicationId": {"type": "string", "format": "uuid"},
    "inventoryDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reports": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["v2PublicationDigest", "databaseBackupId", "rehearsed"],
      "properties": {
        "v2PublicationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "databaseBackupId": {"type": "string", "minLength": 1},
        "rehearsed": {"const": true}
      }
    }
  }
}
