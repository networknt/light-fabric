        {"type": "tool_call", "call": {"id": "call_2", "name": "clock", "arguments": {"zone": "UTC"}}}
      ]},
      {"role": "tool", "content": [{"type": "tool_result", "result": {"toolCallId": "call_1", "content": [{"type": "text", "text": "sunny"}], "isError": false}}]}
    ],
    "tools": [{"name": "weather", "description": "Weather", "inputSchema": {"type": "object"}}],
