      {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "Describe this."}, {"type": "input_image", "image_url": "https://example.test/image.png"}]},
      {"type": "function_call", "call_id": "call_1", "name": "weather", "arguments": "{\"city\":\"Toronto\"}"},
      {"type": "function_call", "call_id": "call_2", "name": "clock", "arguments": "{\"zone\":\"UTC\"}"},
      {"type": "function_call_output", "call_id": "call_1", "output": "sunny"}
    ],
    "tools": [{"type": "function", "name": "weather", "description": "Weather", "parameters": {"type": "object"}}],
    "tool_choice": {"type": "function", "name": "weather"},
    "parallel_tool_calls": true,
    "text": {"format": {"type": "json_schema", "name": "answer", "schema": {"type": "object"}}},
